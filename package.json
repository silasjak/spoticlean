{
  "name": "spoticlean",
  "version": "1.0.1",
  "description": "Interactive CLI to clean up your Spotify playlists and Liked Songs — hear the chorus instantly, then keep or remove.",
  "type": "module",
  "license": "MIT",
  "author": "silasjak <mail@silasjak.dev>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/silasjak/spoticlean.git"
  },
  "bugs": {
    "url": "https://github.com/silasjak/spoticlean/issues"
  },
  "homepage": "https://github.com/silasjak/spoticlean#readme",
  "keywords": [
    "spotify",
    "cli",
    "playlist",
    "liked-songs",
    "music",
    "interactive"
  ],
  "bin": {
    "spoticlean": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:debug": "tsx src/index.ts --debug",
    "build": "tsup src/index.ts --format esm --clean --shims --target node20",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "FORCE_COLOR=1 tsx --test src/**/*.test.ts",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@clack/prompts": "^0.9.1",
    "env-paths": "^3.0.0",
    "figlet": "^1.11.4",
    "gradient-string": "^3.0.0",
    "i18next": "^26.4.2",
    "open": "^10.1.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/gradient-string": "^1.1.6",
    "@types/node": "^20.14.0",
    "eslint": "^9.15.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.16.0"
  }
}
